# 選擇這次測試要用哪一家視訊 SDK："agora" 或 "livekit"
VIDEO_SDK_PROVIDER=agora

# LINE LIFF（在 LINE Developers Console 建立 LINE Login Channel 後取得）
LIFF_ID=

# 測試用固定房間名稱，暫不接排程資料
TEST_ROOM_NAME=poc-test-room

# --- Agora（https://console.agora.io 申請免費專案）---
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# --- LiveKit（https://cloud.livekit.io 申請免費專案）---
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_WS_URL=wss://your-project.livekit.cloud
